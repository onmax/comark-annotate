{
  "name": "comark-linter",
  "version": "0.3.0",
  "description": "Finds unclosed blocks, unknown components, broken anchors, and plugin issues in Comark documents. A library, a CLI, and a Vite Doctor extension.",
  "keywords": [
    "comark",
    "lint",
    "markdown",
    "mdc",
    "vite-doctor"
  ],
  "homepage": "https://comark.onmax.me/lint",
  "bugs": "https://github.com/onmax/comark-plugins/issues",
  "license": "MIT",
  "author": "onmax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/comark-plugins.git",
    "directory": "packages/lint"
  },
  "bin": {
    "lint-comark": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./doctor": "./dist/doctor.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "doctor": "vite-doctor . --no-cache --max-warnings 0 --format text",
    "prepack": "pnpm --filter comark-linter... build"
  },
  "devDependencies": {
    "comark": "catalog:",
    "comark-annotate": "workspace:*",
    "comark-carousel": "workspace:*",
    "comark-charts": "workspace:*",
    "comark-chips": "workspace:*",
    "comark-code": "workspace:*",
    "comark-deflist": "workspace:*",
    "comark-diff": "workspace:*",
    "comark-embed": "workspace:*",
    "comark-github": "workspace:*",
    "comark-icon": "workspace:*",
    "comark-steps": "workspace:*",
    "comark-tabs": "workspace:*",
    "comark-zoom": "workspace:*",
    "vite-doctor": "catalog:"
  },
  "peerDependencies": {
    "comark": "^0.8.0",
    "comark-annotate": "workspace:^",
    "comark-carousel": "workspace:^",
    "comark-charts": "workspace:^",
    "comark-chips": "workspace:^",
    "comark-code": "workspace:^",
    "comark-deflist": "workspace:^",
    "comark-diff": "workspace:^",
    "comark-embed": "workspace:^",
    "comark-github": "workspace:^",
    "comark-icon": "workspace:^",
    "comark-steps": "workspace:^",
    "comark-tabs": "workspace:^",
    "comark-zoom": "workspace:^",
    "vite-doctor": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "comark-annotate": {
      "optional": true
    },
    "comark-carousel": {
      "optional": true
    },
    "comark-charts": {
      "optional": true
    },
    "comark-chips": {
      "optional": true
    },
    "comark-code": {
      "optional": true
    },
    "comark-deflist": {
      "optional": true
    },
    "comark-diff": {
      "optional": true
    },
    "comark-embed": {
      "optional": true
    },
    "comark-github": {
      "optional": true
    },
    "comark-icon": {
      "optional": true
    },
    "comark-steps": {
      "optional": true
    },
    "comark-tabs": {
      "optional": true
    },
    "comark-zoom": {
      "optional": true
    },
    "vite-doctor": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
