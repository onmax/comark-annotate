{
  "name": "comark-charts",
  "version": "0.2.0",
  "description": "Charts from a Markdown table, drawn to SVG with no script: bars, stacked bars, lines, areas, scatter plots, dumbbells, waterfalls, and pies. The table stays in the page, so people see the chart and agents read the numbers. A Comark plugin.",
  "keywords": [
    "chart",
    "comark",
    "flint",
    "markdown",
    "mdc",
    "plugin",
    "svg",
    "vega"
  ],
  "homepage": "https://comark.onmax.me/charts",
  "bugs": "https://github.com/onmax/comark-plugins/issues",
  "license": "MIT",
  "author": "onmax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/comark-plugins.git",
    "directory": "packages/charts"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./html": "./dist/html.mjs",
    "./package.json": "./package.json",
    "./skills/*": "./skills/*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "doctor": "vite-doctor . --no-cache --max-warnings 0 --format text",
    "prepack": "pnpm --filter comark-charts... build"
  },
  "dependencies": {
    "comark-annotate": "workspace:*",
    "flint-chart": "catalog:",
    "vega": "catalog:",
    "vega-interpreter": "catalog:",
    "vega-lite": "catalog:"
  },
  "devDependencies": {
    "@comark/html": "catalog:",
    "comark": "catalog:",
    "comark-zoom": "workspace:*"
  },
  "peerDependencies": {
    "@comark/html": "^0.7.0",
    "comark": "^0.7.0"
  },
  "peerDependenciesMeta": {
    "@comark/html": {
      "optional": true
    }
  }
}
