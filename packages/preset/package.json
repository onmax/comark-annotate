{
  "name": "@onmax/comark",
  "version": "0.3.0",
  "description": "onmax's Comark preset: every comark-plugins package in one install, registered in the right order with shared icons. Turn any of them off or pass its options.",
  "keywords": [
    "comark",
    "markdown",
    "plugin",
    "preset"
  ],
  "homepage": "https://comark.onmax.me/preset",
  "bugs": "https://github.com/onmax/comark-plugins/issues",
  "license": "MIT",
  "author": "onmax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/comark-plugins.git",
    "directory": "packages/preset"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./html": "./dist/html.mjs",
    "./react": "./dist/react.mjs",
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./vue": "./dist/vue.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "doctor": "vite-doctor . --no-cache --max-warnings 0 --format text",
    "prepack": "pnpm --filter @onmax/comark... build"
  },
  "dependencies": {
    "comark-annotate": "workspace:^",
    "comark-badge": "workspace:^",
    "comark-cards": "workspace:^",
    "comark-carousel": "workspace:^",
    "comark-charts": "workspace:^",
    "comark-chips": "workspace:^",
    "comark-code": "workspace:^",
    "comark-details": "workspace:^",
    "comark-diff": "workspace:^",
    "comark-embed": "workspace:^",
    "comark-fields": "workspace:^",
    "comark-file-tree": "workspace:^",
    "comark-github": "workspace:^",
    "comark-icon": "workspace:^",
    "comark-include": "workspace:^",
    "comark-media": "workspace:^",
    "comark-steps": "workspace:^",
    "comark-tabs": "workspace:^",
    "comark-zoom": "workspace:^"
  },
  "devDependencies": {
    "@comark/html": "catalog:",
    "@comark/react": "catalog:",
    "@comark/vue": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "comark": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "svelte": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "@comark/html": "^0.8.0",
    "comark": "^0.8.0",
    "react": ">=18",
    "svelte": ">=5.20",
    "vue": ">=3.5"
  },
  "peerDependenciesMeta": {
    "@comark/html": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
