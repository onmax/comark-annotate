{
  "name": "comark-annotate",
  "version": "0.0.4",
  "description": "Hand-drawn marks, numbered notes, and arrows on screenshots, written in Markdown. A Comark plugin.",
  "keywords": [
    "annotation",
    "comark",
    "markdown",
    "mdc",
    "plugin",
    "screenshot"
  ],
  "homepage": "https://comark.onmax.me/annotate",
  "bugs": "https://github.com/onmax/comark-plugins/issues",
  "license": "MIT",
  "author": "onmax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/comark-plugins.git",
    "directory": "packages/annotate"
  },
  "bin": {
    "comark-annotate": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./html": "./dist/html.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "doctor": "vite-doctor . --no-cache --max-warnings 0 --format text",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@comark/html": "catalog:",
    "comark": "catalog:"
  },
  "peerDependencies": {
    "@comark/html": "^0.7.0",
    "comark": "^0.7.0"
  }
}
