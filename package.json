{
  "name": "comark-annotate",
  "version": "0.0.2",
  "description": "Hand-drawn marks, numbered notes, and arrows on screenshots, written in Markdown. A Comark plugin.",
  "keywords": [
    "annotation",
    "comark",
    "markdown",
    "mdc",
    "plugin",
    "screenshot"
  ],
  "homepage": "https://comark-annotate.onmax.me",
  "bugs": "https://github.com/onmax/comark-annotate/issues",
  "license": "MIT",
  "author": "onmax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/comark-annotate.git"
  },
  "bin": {
    "comark-annotate": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./html": "./dist/html.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "docs:build": "node docs/build.ts",
    "lint": "vp lint",
    "typecheck": "tsc --noEmit",
    "test": "vp test",
    "doctor": "vite-doctor . --no-cache --max-warnings 0 --format text",
    "check": "vp check",
    "ready": "vp fmt && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm run doctor",
    "release:check": "vp fmt --check && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm run doctor",
    "prepare": "vp config",
    "prepack": "pnpm build",
    "deploy": "pnpm docs:build && pnpm dlx wrangler deploy"
  },
  "devDependencies": {
    "@comark/html": "catalog:",
    "@fontsource-variable/caveat": "catalog:",
    "@types/node": "catalog:",
    "comark": "catalog:",
    "geist": "catalog:",
    "pkg-pr-new": "catalog:",
    "shiki": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-doctor": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@comark/html": "^0.7.0",
    "comark": "^0.7.0"
  },
  "packageManager": "pnpm@11.18.0"
}
