{
  "name": "comark-plugins",
  "private": true,
  "description": "Comark plugins by onmax: annotated screenshots, zoom, carousels, GitHub callouts, and embeds. One version for every package.",
  "homepage": "https://comark.onmax.me",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onmax/comark-plugins.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "docs:build": "pnpm build && node docs/build.ts",
    "lint": "vp lint",
    "typecheck": "tsc --noEmit",
    "test": "vp test",
    "doctor": "pnpm -r --filter \"./packages/*\" run doctor",
    "check": "vp check",
    "ready": "vp fmt && pnpm build && pnpm check && pnpm test && pnpm run doctor",
    "release:check": "pnpm build && pnpm check && pnpm test && pnpm run doctor",
    "prepare": "vp config",
    "deploy": "pnpm docs:build && pnpm dlx wrangler deploy",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@comark/html": "catalog:",
    "@fontsource-variable/caveat": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "comark": "catalog:",
    "geist": "catalog:",
    "pkg-pr-new": "catalog:",
    "publint": "catalog:",
    "shiki": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-doctor": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@11.18.0"
}
